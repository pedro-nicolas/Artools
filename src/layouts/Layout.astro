---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Arttools PRO',
	description = 'A AR|P1 redefine o equilíbrio entre peso, fluxo e design. Engenharia aeroespacial em titânio e rotação giroscópica para criadores de ponta.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Arttools PRO | Caneta de Precisão em Titânio Grade 5" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/images/pen_macro_zoom.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Arttools PRO | Caneta de Precisão em Titânio Grade 5" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/images/pen_macro_zoom.jpg" />

    <!-- Favicon (SVG Minimalista) -->
    <link rel="icon" type="image/svg+xml"
        href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231C1C1C' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolygon points='12 2 2 7 12 12 22 7 12 2'%3E%3C/polygon%3E%3Cpolyline points='2 17 12 22 22 17'%3E%3C/polyline%3E%3Cpolyline points='2 12 17 12 17 22 12'%3E%3C/polyline%3E%3C/svg%3E" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet" />

    <!-- External Stylesheet -->
    <link rel="stylesheet" href="/assets/css/style.css?v=20260921" />

    <!-- GSAP + ScrollTrigger (CDN) -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <!-- ScrollyVideo: Hardware Accelerated WebCodecs & Canvas Frame-Scrubbing -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/scrolly-video@latest/dist/scrolly-video.js"></script>

    <!-- Iconify (CDN) -->
    <script is:inline src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
</head>

<body>
    <!-- Ancora de topo para logo (#hero) e explorar (#explorar) -->
    <span id="hero" style="position: absolute; top: 0; left: 0; pointer-events: none;" aria-hidden="true"></span>
    <span id="explorar" style="position: absolute; top: 0; left: 0; pointer-events: none;" aria-hidden="true"></span>
    <!-- Subtle Architectural Noise Texture -->
    <div class="noise-layer" aria-hidden="true"></div>

    <!-- Subtle Grid Lines -->
    <div class="grid-guide" aria-hidden="true">
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
    </div>

    <!-- 1. MINIMALIST TOP NAVBAR -->
    <Header />

    <slot />

    <!-- 10. MINIMALIST GRAPHITE FOOTER -->
    <Footer />

    <!-- Main Application JavaScript -->
    <script is:inline src="/assets/js/main.js"></script>
</body>

</html>
