---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	canonicalURL?: string | URL;
	image?: string;
}

const {
	title = 'ArtTools | Instrumentos de Precisão',
	description = 'ArtTools — Instrumentos de escrita de alta precisão em titânio aeroespacial e cerâmica para criadores contemporâneos.',
	canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href,
	image = '/assets/images/pen_damascus.jpg',
} = Astro.props;

const canonical = typeof canonicalURL === 'string' ? canonicalURL : canonicalURL.href;
const absoluteImageUrl = new URL(image, Astro.site || Astro.url.origin).href;
---

<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">

<head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/assets/images/Imag.ico" />
    <link rel="shortcut icon" href="/assets/images/Imag.ico" />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />


    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
        rel="stylesheet" />

    <!-- External Stylesheet -->
    <link rel="stylesheet" href="/assets/css/style.css?v=20260921" />

    <!-- GSAP + ScrollTrigger (CDN) -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <!-- ScrollyVideo: Hardware Accelerated WebCodecs & Canvas Frame-Scrubbing -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/scrolly-video@latest/dist/scrolly-video.js"></script>

    <!-- Iconify (CDN) -->
    <script is:inline src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
</head>

<body>
    <!-- Ancora de topo para logo (#hero) e explorar (#explorar) -->
    <span id="hero" style="position: absolute; top: 0; left: 0; pointer-events: none;" aria-hidden="true"></span>
    <span id="explorar" style="position: absolute; top: 0; left: 0; pointer-events: none;" aria-hidden="true"></span>
    <!-- Subtle Architectural Noise Texture -->
    <div class="noise-layer" aria-hidden="true"></div>

    <!-- Subtle Grid Lines -->
    <div class="grid-guide" aria-hidden="true">
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
        <div class="grid-guide-col"></div>
    </div>

    <!-- 1. MINIMALIST TOP NAVBAR -->
    <Header transition:persist />

    <slot />

    <!-- 10. MINIMALIST GRAPHITE FOOTER -->
    <Footer transition:persist />

    <!-- Main Application JavaScript -->
    <script is:inline src="/assets/js/main.js"></script>
</body>

</html>
