---
// Header.astro - Cabeçalho Fiel à Identidade Visual Artools PRO
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isCatalogo = pathname.startsWith('/pagina');
const isProduto = pathname.startsWith('/produto') || pathname.startsWith('/detalhes');
---

<header class="site-header loaded" id="navbar" role="banner">
    <div class="header-inner">
        <a href="/" class="brand" aria-label="ARTOOLS Home">
            <div class="brand-icon-box">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 20h9"></path>
                    <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
            </div>
            <span class="brand-text">ARTOOLS</span>
        </a>

        <nav aria-label="Navegação Principal">
            <ul class="nav-links-clean">
                <li>
                    <a href="/" class={`clean-nav-link ${isHome ? 'active' : ''}`}>
                        INÍCIO
                    </a>
                </li>
                <li>
                    <a href="/pagina" class={`clean-nav-link ${isCatalogo ? 'active' : ''}`}>
                        CATÁLOGO
                    </a>
                </li>
                <li>
                    <a href="/produto" class={`clean-nav-link ${isProduto ? 'active' : ''}`}>
                        DETALHES DO PRODUTO
                    </a>
                </li>
            </ul>
        </nav>

        <div class="header-spacer" aria-hidden="true"></div>
    </div>
</header>

<style>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 100;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        transform: translateY(0);
        opacity: 1;
    }

    .header-inner {
        max-width: 1240px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 1.25rem 2rem;
    }

    .brand {
        justify-self: start;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        color: #1C1C1C;
    }

    nav {
        justify-self: center;
    }

    .brand-icon-box {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1C1C1C;
    }

    .brand-text {
        font-family: var(--font-sans, sans-serif);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #1C1C1C;
    }

    .nav-links-clean {
        display: flex;
        align-items: center;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .clean-nav-link {
        font-family: var(--font-mono, monospace);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #70706E;
        text-decoration: none;
        padding: 0.35rem 0;
        position: relative;
        transition: color 0.2s ease;
    }

    .clean-nav-link:hover {
        color: #1C1C1C;
    }

    .clean-nav-link.active {
        color: #1C1C1C;
        font-weight: 700;
    }

    .clean-nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -6px;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #1C1C1C;
    }

    @media (max-width: 640px) {
        .header-inner {
            padding: 1rem 1.25rem;
        }
        .nav-links-clean {
            gap: 1rem;
        }
        .clean-nav-link {
            font-size: 0.65rem;
        }
    }
</style>
