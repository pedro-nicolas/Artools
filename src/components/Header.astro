---
// Header.astro - Cabeçalho Fiel à Identidade Visual Artools PRO
const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const isCatalogo = pathname.startsWith("/catalogo");
const isProduto = pathname.startsWith("/produto");
---

<header class="site-header loaded" id="navbar" role="banner">
    <div class="header-inner">
        <a href="/" class="brand" aria-label="ARTOOLS Home">
            <div class="brand-icon-box">
                <svg
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M12 20h9"></path>
                    <path
                        d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                    ></path>
                </svg>
            </div>
            <span class="brand-text">ARTTOOLS</span>
        </a>

        <nav aria-label="Navegação Principal" id="main-nav">
            <ul class="nav-links-clean">
                <li>
                    <a
                        href="/"
                        class={`clean-nav-link ${isHome ? "active" : ""}`}
                    >
                        INÍCIO
                    </a>
                </li>
                <li>
                    <a
                        href="/catalogo"
                        class={`clean-nav-link ${isCatalogo ? "active" : ""}`}
                    >
                        CATÁLOGO
                    </a>
                </li>
                <li>
                    <a
                        href="/produto/ar-p1"
                        class={`clean-nav-link ${isProduto ? "active" : ""}`}
                    >
                        DETALHES DO PRODUTO
                    </a>
                </li>
            </ul>
        </nav>

        <button
            class="mobile-menu-btn"
            id="mobile-menu-btn"
            aria-label="Alternar menu de navegação"
            aria-expanded="false"
            aria-controls="main-nav"
        >
            <svg
                class="icon-hamburger"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <line x1="3" y1="6" x2="21" y2="6" class="line-top"></line>
                <line x1="3" y1="12" x2="21" y2="12" class="line-mid"></line>
                <line x1="3" y1="18" x2="21" y2="18" class="line-bot"></line>
            </svg>
        </button>

        <div class="header-spacer" aria-hidden="true"></div>
    </div>
</header>

<script>
    const menuBtn = document.getElementById("mobile-menu-btn");
    const header = document.getElementById("navbar");

    if (menuBtn && header) {
        menuBtn.addEventListener("click", () => {
            const isOpen = header.classList.contains("menu-open");
            if (isOpen) {
                header.classList.remove("menu-open");
                menuBtn.setAttribute("aria-expanded", "false");
            } else {
                header.classList.add("menu-open");
                menuBtn.setAttribute("aria-expanded", "true");
            }
        });

        const navLinks = header.querySelectorAll(".clean-nav-link");
        navLinks.forEach((link) => {
            link.addEventListener("click", () => {
                header.classList.remove("menu-open");
                menuBtn.setAttribute("aria-expanded", "false");
            });
        });
    }
</script>

<style is:global>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 100;
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        transform: translateY(0);
        opacity: 1;
        transition: background-color 0.2s ease;
    }

    .header-inner {
        max-width: 1240px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 1.25rem 2rem;
    }

    .brand {
        justify-self: start;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        text-decoration: none;
        color: #1c1c1c;
    }

    nav {
        justify-self: center;
    }

    .brand-icon-box {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1c1c1c;
    }

    .brand-text {
        font-family: var(--font-sans, sans-serif);
        font-size: 0.95rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #1c1c1c;
    }

    .nav-links-clean {
        display: flex;
        align-items: center;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .clean-nav-link {
        font-family: var(--font-mono, monospace);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #70706e;
        text-decoration: none;
        padding: 0.35rem 0;
        position: relative;
        transition: color 0.2s ease;
    }

    .clean-nav-link:hover {
        color: #1c1c1c;
    }

    .clean-nav-link.active {
        color: #1c1c1c;
        font-weight: 700;
    }

    .clean-nav-link.active::after {
        content: "";
        position: absolute;
        bottom: -6px;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #1c1c1c;
    }

    .mobile-menu-btn {
        display: none;
        background: transparent;
        border: none;
        color: #1c1c1c;
        cursor: pointer;
        padding: 0.4rem;
        border-radius: 4px;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease;
    }

    .mobile-menu-btn:hover {
        background-color: rgba(0, 0, 0, 0.04);
    }

    .mobile-menu-btn svg {
        transition: transform 0.2s ease;
    }

    .line-top,
    .line-mid,
    .line-bot {
        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
        transform-origin: center;
    }

    .site-header.menu-open .line-top {
        transform: translateY(6px) rotate(45deg);
    }

    .site-header.menu-open .line-mid {
        opacity: 0;
    }

    .site-header.menu-open .line-bot {
        transform: translateY(-6px) rotate(-45deg);
    }

    @media (max-width: 768px) {
        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem 1.25rem;
        }

        .header-spacer {
            display: none;
        }

        .mobile-menu-btn {
            display: flex;
        }

        nav {
            position: absolute;
            top: calc(100% + 0.5rem);
            right: 1.25rem;
            left: auto;
            width: calc(100vw - 2.5rem);
            max-width: 280px;
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 16px;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.04);
            padding: 0.5rem;
            display: block;
            pointer-events: none;
            opacity: 0;
            transform: translateY(-8px) scale(0.96);
            transform-origin: top right;
            transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .site-header.menu-open nav {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0) scale(1);
        }

        .nav-links-clean {
            flex-direction: column;
            align-items: stretch;
            gap: 0.25rem;
        }

        .clean-nav-link {
            font-size: 0.75rem;
            letter-spacing: 0.08em;
            padding: 0.75rem 1rem;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.2s ease;
        }

        .clean-nav-link:hover {
            background-color: rgba(0, 0, 0, 0.04);
        }

        .clean-nav-link.active {
            background-color: #1c1c1c;
            color: #ffffff;
            font-weight: 700;
        }

        .clean-nav-link.active::after {
            display: none;
        }
    }
</style>
