---
// produto.astro - Detalhes do Produto Fiel à Identidade Visual Artools PRO
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { products } from '../data/products';

// Produto padrão: Precision Ceramic White (conforme imagem de referência)
const defaultProduct = products[1] || products[0];
---

<Layout
    title={`${defaultProduct.name} | Detalhes do Produto — Arttools PRO`}
    description={`Galeria de fotos e especificações de compra do instrumento ${defaultProduct.code} ${defaultProduct.name}.`}
>
    <main class="page-white-bg">
        <div class="product-page-container">
            <!-- Breadcrumbs -->
            <nav class="product-breadcrumbs" aria-label="Navegação estrutural">
                <a href="/" class="crumb-link">INÍCIO</a>
                <span class="crumb-sep">/</span>
                <a href="/pagina" class="crumb-link">CATÁLOGO</a>
                <span class="crumb-sep">/</span>
                <span class="crumb-active" id="crumb-active-name">{defaultProduct.name.toUpperCase()}</span>
            </nav>

            <!-- Grid Principal de 2 Colunas -->
            <section class="product-layout-grid" aria-label="Apresentação do Produto">
                <!-- ==============================================================
                     COLUNA ESQUERDA: GALERIA DE FOTOS + ITENS INCLUSOS ABAIXO
                     ============================================================== -->
                <div class="product-gallery-column">
                    <!-- Moldura da Imagem Principal com Badges -->
                    <div class="product-hero-frame">
                        <div class="frame-badges-overlay">
                            <span class="badge-pill badge-dark" id="hero-badge-left">NOVO LANÇAMENTO</span>
                            <span class="badge-pill badge-light" id="hero-badge-right">{defaultProduct.status.toUpperCase()}</span>
                        </div>

                        <div class="hero-image-wrapper">
                            <img
                                id="gallery-main-img"
                                src={defaultProduct.image}
                                alt={`Instrumento ${defaultProduct.name}`}
                            />
                        </div>
                    </div>

                    <!-- Miniaturas das Fotos (4 Quadrados) -->
                    <div class="gallery-thumbs-row" aria-label="Miniaturas de fotos">
                        <button type="button" class="thumb-square active" data-img="/assets/images/pen_stealth.jpg" aria-label="Foto 1: Titanium Stealth">
                            <img src="/assets/images/pen_stealth.jpg" alt="Acabamento Titânio" />
                        </button>
                        <button type="button" class="thumb-square" data-img="/assets/images/pen_ceramic.jpg" aria-label="Foto 2: Ceramic White">
                            <img src="/assets/images/pen_ceramic.jpg" alt="Acabamento Cerâmica Branca" />
                        </button>
                        <button type="button" class="thumb-square" data-img="/assets/images/pen_blue.jpg" aria-label="Foto 3: Cobalt Aero">
                            <img src="/assets/images/pen_blue.jpg" alt="Versão Azul Cobalto" />
                        </button>
                        <button type="button" class="thumb-square" data-img="/assets/images/pen_silver.jpg" aria-label="Foto 4: Flux Silver">
                            <img src="/assets/images/pen_silver.jpg" alt="Versão Prata Escovada" />
                        </button>
                    </div>

                    <!-- ITENS INCLUSOS ABAIXO DAS IMAGENS (conforme solicitado pelo usuário) -->
                    <div class="inbox-section-below">
                        <h3 class="inbox-heading">ITENS INCLUSOS NO ESTOJO</h3>
                        <ul class="inbox-bullet-list" id="inbox-items-list">
                            {defaultProduct.inBox.map((item) => (
                                <li>
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>

                <!-- ==============================================================
                     COLUNA DIREITA: INFORMAÇÕES DE COMPRA + AVISE-ME
                     ============================================================== -->
                <div class="product-purchase-column">
                    <!-- Pre-título em Pill Badge com bolinha verde -->
                    <div class="purchase-eyebrow">
                        <span class="badge-dot" aria-hidden="true"></span>
                        <span id="purchase-eyebrow-text">PRECISÃO & ENGENHARIA</span>
                    </div>

                    <!-- Título da Caneta -->
                    <h1 class="purchase-title" id="purchase-product-title">{defaultProduct.name}</h1>

                    <!-- Descrição Breve -->
                    <p class="purchase-brief-desc" id="purchase-brief-desc">{defaultProduct.utility}</p>

                    <!-- Preço Exclusivo e Lote Futuro -->
                    <div class="purchase-pricing-row">
                        <div class="price-stack">
                            <span class="price-tiny-label">PREÇO EXCLUSIVO</span>
                            <span class="price-main-val" id="purchase-price">{defaultProduct.price}</span>
                        </div>
                        <span class="batch-future-tag">LOTE FUTURO</span>
                    </div>

                    <!-- Especificações Rápidas e Minimalistas (3 Colunas no Box Cinza Claro) -->
                    <div class="quick-specs-container">
                        <div class="quick-specs-label">ESPECIFICAÇÕES RÁPIDAS</div>
                        <div class="quick-specs-grid">
                            <div class="quick-spec-item">
                                <span class="spec-term">PENA</span>
                                <span class="spec-def" id="spec-tip">{defaultProduct.tip}</span>
                            </div>
                            <div class="quick-spec-item">
                                <span class="spec-term">MATERIAL</span>
                                <span class="spec-def" id="spec-mat">{defaultProduct.material}</span>
                            </div>
                            <div class="quick-spec-item">
                                <span class="spec-term">RECARGA</span>
                                <span class="spec-def" id="spec-refill">{defaultProduct.refill || 'Rollerball G2'}</span>
                            </div>
                        </div>
                    </div>

                    <!-- Seletor de Modelo (Cards com Nome e Status) -->
                    <div class="model-selection-wrapper">
                        <div class="selection-label">SELECIONE O MODELO</div>

                        <!-- 1ª Linha: Apenas os 3 Modelos Iniciais -->
                        <div class="model-cards-row" id="model-primary-row">
                            {products.slice(0, 3).map((p) => (
                                <button
                                    type="button"
                                    class={`model-select-card ${p.id === defaultProduct.id ? 'active' : ''}`}
                                    data-model-id={p.id}
                                    aria-label={`Selecionar modelo ${p.name}`}
                                >
                                    <span class="model-select-name">{p.name}</span>
                                    <span class="model-select-status">{p.status}</span>
                                </button>
                            ))}
                        </div>

                        <!-- Botão Ver mais / Ver menos posicionado diretamente abaixo da 1ª linha -->
                        <div class="model-selection-footer">
                            <button
                                type="button"
                                class="btn-toggle-more-models"
                                id="toggle-more-models-btn"
                                aria-expanded="false"
                                aria-label="Alternar exibição de mais modelos"
                            >
                                <span class="toggle-text">Ver mais</span>
                                <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>

                        <!-- Modelos Restantes: Revelados abaixo do botão ao clicar -->
                        <div class="more-models-container" id="more-models-container" style="display: none;">
                            <div class="model-cards-row">
                                {products.slice(3).map((p) => (
                                    <button
                                        type="button"
                                        class={`model-select-card ${p.id === defaultProduct.id ? 'active' : ''}`}
                                        data-model-id={p.id}
                                        aria-label={`Selecionar modelo ${p.name}`}
                                    >
                                        <span class="model-select-name">{p.name}</span>
                                        <span class="model-select-status">{p.status}</span>
                                    </button>
                                ))}
                            </div>
                        </div>
                    </div>

                    <!-- Botão de Ação: Avise-me (Abre Pop-up Modal) -->
                    <div class="action-submit-area">
                        <button
                            type="button"
                            id="open-notify-modal-btn"
                            class="btn-avise-me-hero"
                            aria-label="Avise-me quando disponível"
                        >
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <span>AVISE-ME</span>
                        </button>
                        <p class="action-subtext">
                            Cadastre-se para ser notificado assim que o estoque for renovado.
                        </p>
                    </div>
                </div>
            </section>
        </div>

        <!-- ==========================================================================
             POP-UP MODAL: FORMULÁRIO DE AVISE-ME (NOME, TELEFONE, EMAIL)
             ========================================================================== -->
        <dialog id="notify-dialog" class="pure-popup-modal" aria-labelledby="popup-heading">
            <div class="popup-box-inner">
                <button type="button" class="popup-close-x" id="modal-close-btn" aria-label="Fechar pop-up">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>

                <!-- Visão do Formulário -->
                <div id="modal-form-view">
                    <div class="popup-header">
                        <span class="popup-pen-code" id="popup-pen-code">{defaultProduct.code}</span>
                        <h2 class="popup-title" id="popup-heading">Avise-me quando disponível</h2>
                        <p class="popup-lead">
                            Cadastre seus dados para receber aviso prioritário de compra do modelo <strong id="popup-pen-name">{defaultProduct.name}</strong>.
                        </p>
                    </div>

                    <form id="notify-popup-form" class="popup-form-fields" novalidate>
                        <div class="popup-field">
                            <label for="input-nome">Nome Completo</label>
                            <input
                                type="text"
                                id="input-nome"
                                name="nome"
                                required
                                placeholder="Digite seu nome completo"
                                autocomplete="name"
                            />
                        </div>

                        <div class="popup-field">
                            <label for="input-telefone">Telefone / WhatsApp</label>
                            <input
                                type="tel"
                                id="input-telefone"
                                name="telefone"
                                required
                                placeholder="(11) 99999-9999"
                                autocomplete="tel"
                            />
                        </div>

                        <div class="popup-field">
                            <label for="input-email">E-mail</label>
                            <input
                                type="email"
                                id="input-email"
                                name="email"
                                required
                                placeholder="seu.email@exemplo.com"
                                autocomplete="email"
                            />
                        </div>

                        <div class="popup-actions">
                            <Button variant="notify" type="submit" id="modal-submit-btn" class="popup-submit-btn">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                </svg>
                                <span>Confirmar Inscrição</span>
                            </Button>
                        </div>

                        <p class="popup-privacy">
                            Informações confidenciais. Notificação única e sigilosa.
                        </p>
                    </form>
                </div>

                <!-- Visão de Sucesso -->
                <div id="modal-success-view" class="popup-success-view" style="display: none;">
                    <div class="success-icon-badge">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <h3 class="popup-title">Inscrição Confirmada!</h3>
                    <p class="popup-lead" id="popup-success-msg">
                        Avisaremos você por WhatsApp e e-mail assim que a próxima tiragem for aberta.
                    </p>
                    <div class="popup-actions" style="margin-top: 1.5rem;">
                        <Button variant="notify" type="button" id="modal-finish-btn" class="popup-submit-btn">
                            <span>Concluir</span>
                        </Button>
                    </div>
                </div>
            </div>
        </dialog>
    </main>

    <!-- Dados JSON Embutidos -->
    <script id="products-data" type="application/json" set:html={JSON.stringify(products)} />

    <!-- Script de Interatividade e Troca Dinâmica -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const dataEl = document.getElementById('products-data');
            if (!dataEl) return;
            const products = JSON.parse(dataEl.textContent || '[]');

            // Elementos DOM
            const crumbActive = document.getElementById('crumb-active-name');
            const mainImg = document.getElementById('gallery-main-img');
            const heroBadgeRight = document.getElementById('hero-badge-right');

            const purchaseTitle = document.getElementById('purchase-product-title');
            const purchaseBrief = document.getElementById('purchase-brief-desc');
            const purchasePrice = document.getElementById('purchase-price');

            const specTip = document.getElementById('spec-tip');
            const specMat = document.getElementById('spec-mat');
            const specRefill = document.getElementById('spec-refill');

            const inboxList = document.getElementById('inbox-items-list');

            const modelCards = document.querySelectorAll('.model-select-card');
            const thumbBtns = document.querySelectorAll('.thumb-square');

            // Modal
            const dialog = document.getElementById('notify-dialog');
            const openModalBtn = document.getElementById('open-notify-modal-btn');
            const closeModalBtn = document.getElementById('modal-close-btn');
            const finishModalBtn = document.getElementById('modal-finish-btn');
            const modalForm = document.getElementById('notify-popup-form');
            const modalFormView = document.getElementById('modal-form-view');
            const modalSuccessView = document.getElementById('modal-success-view');
            const modalSuccessMsg = document.getElementById('popup-success-msg');

            const popupPenCode = document.getElementById('popup-pen-code');
            const popupPenName = document.getElementById('popup-pen-name');

            const inputNome = document.getElementById('input-nome');
            const inputTelefone = document.getElementById('input-telefone');
            const inputEmail = document.getElementById('input-email');

            let currentProduct = products[1] || products[0];

            function renderProduct(p) {
                if (!p) return;
                currentProduct = p;
                document.title = `${p.name} | Detalhes do Produto — Arttools PRO`;

                if (crumbActive) crumbActive.textContent = p.name.toUpperCase();
                if (mainImg) {
                    mainImg.src = p.image;
                    mainImg.alt = `Caneta ${p.name}`;
                }
                if (heroBadgeRight) {
                    heroBadgeRight.textContent = (p.status || 'EM BREVE').toUpperCase();
                }

                if (purchaseTitle) purchaseTitle.textContent = p.name;
                if (purchaseBrief) purchaseBrief.textContent = p.utility;
                if (purchasePrice) purchasePrice.textContent = p.price;

                if (specTip) specTip.textContent = p.tip;
                if (specMat) specMat.textContent = p.material;
                if (specRefill) specRefill.textContent = p.refill || 'Rollerball G2';

                // Atualiza Itens Inclusos
                if (inboxList && Array.isArray(p.inBox)) {
                    inboxList.innerHTML = p.inBox.map(item => `
                        <li>
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>${item}</span>
                        </li>
                    `).join('');
                }

                if (popupPenCode) popupPenCode.textContent = p.code;
                if (popupPenName) popupPenName.textContent = p.name;

                // Atualiza seleção dos cards de modelo
                const allCards = document.querySelectorAll('.model-select-card');
                allCards.forEach((btn) => {
                    const id = btn.getAttribute('data-model-id');
                    if (id === p.id) {
                        btn.classList.add('active');
                    } else {
                        btn.classList.remove('active');
                    }
                });

                // Se o produto selecionado for dos modelos adicionais, abre o container
                const targetIdx = products.findIndex(item => item.id === p.id);
                if (targetIdx >= 3) {
                    setExpanded(true);
                }

                // Sincroniza miniaturas ativas
                thumbBtns.forEach((tb) => {
                    const img = tb.getAttribute('data-img');
                    if (img === p.image) {
                        tb.classList.add('active');
                    } else {
                        tb.classList.remove('active');
                    }
                });
            }

            // Controle de Alternância: Expandir / Recolher Modelos ("Ver mais" / "Ver menos")
            const toggleMoreBtn = document.getElementById('toggle-more-models-btn');
            const moreModelsContainer = document.getElementById('more-models-container');
            const toggleText = toggleMoreBtn ? toggleMoreBtn.querySelector('.toggle-text') : null;

            function setExpanded(expand) {
                if (!moreModelsContainer || !toggleMoreBtn) return;
                if (expand) {
                    moreModelsContainer.style.display = 'block';
                    toggleMoreBtn.classList.add('active');
                    toggleMoreBtn.setAttribute('aria-expanded', 'true');
                    if (toggleText) toggleText.textContent = 'Ver menos';
                } else {
                    moreModelsContainer.style.display = 'none';
                    toggleMoreBtn.classList.remove('active');
                    toggleMoreBtn.setAttribute('aria-expanded', 'false');
                    if (toggleText) toggleText.textContent = 'Ver mais';
                }
            }

            if (toggleMoreBtn) {
                toggleMoreBtn.addEventListener('click', () => {
                    const isVisible = moreModelsContainer && moreModelsContainer.style.display !== 'none';
                    setExpanded(!isVisible);
                });
            }

            // Checa Query Params da URL (ex: ?id=AR-P1)
            const params = new URLSearchParams(window.location.search);
            const queryId = params.get('id');
            if (queryId) {
                const found = products.find(p => p.id.toLowerCase() === queryId.toLowerCase() || p.code.toLowerCase().includes(queryId.toLowerCase()));
                if (found) {
                    renderProduct(found);
                }
            }

            // Seleção de Modelo via Delegação de Eventos no Wrapper
            const modelWrapper = document.querySelector('.model-selection-wrapper');
            if (modelWrapper) {
                modelWrapper.addEventListener('click', (e) => {
                    const btn = e.target.closest('.model-select-card');
                    if (!btn) return;
                    const id = btn.getAttribute('data-model-id');
                    const target = products.find(p => p.id === id);
                    if (target) {
                        renderProduct(target);
                        const newUrl = `${window.location.pathname}?id=${target.id}`;
                        window.history.pushState({ id: target.id }, '', newUrl);
                    }
                });
            }

            // Suporte para Navegação Voltar/Avançar
            window.addEventListener('popstate', () => {
                const pId = new URLSearchParams(window.location.search).get('id');
                const target = products.find(p => p.id.toLowerCase() === (pId || '').toLowerCase() || p.code.toLowerCase().includes((pId || '').toLowerCase())) || products[1] || products[0];
                renderProduct(target);
            });

            // Troca de Foto via Miniaturas
            thumbBtns.forEach((btn) => {
                btn.addEventListener('click', () => {
                    thumbBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    const imgUrl = btn.getAttribute('data-img');
                    if (imgUrl && mainImg) {
                        mainImg.src = imgUrl;
                    }
                });
            });

            // Pop-up Modal Controls
            function openModal() {
                if (!dialog) return;
                if (modalFormView) modalFormView.style.display = 'block';
                if (modalSuccessView) modalSuccessView.style.display = 'none';
                if (modalForm) modalForm.reset();

                if (typeof dialog.showModal === 'function') {
                    dialog.showModal();
                } else {
                    dialog.setAttribute('open', '');
                }
            }

            function closeModal() {
                if (!dialog) return;
                if (typeof dialog.close === 'function') {
                    dialog.close();
                } else {
                    dialog.removeAttribute('open');
                }
            }

            if (openModalBtn) openModalBtn.addEventListener('click', openModal);
            if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
            if (finishModalBtn) finishModalBtn.addEventListener('click', closeModal);

            if (dialog) {
                dialog.addEventListener('click', (e) => {
                    const rect = dialog.getBoundingClientRect();
                    const inDialog = (
                        rect.top <= e.clientY &&
                        e.clientY <= rect.top + rect.height &&
                        rect.left <= e.clientX &&
                        e.clientX <= rect.left + rect.width
                    );
                    if (!inDialog) closeModal();
                });
            }

            if (modalForm) {
                modalForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const nome = inputNome ? inputNome.value.trim() : '';
                    const tel = inputTelefone ? inputTelefone.value.trim() : '';
                    const email = inputEmail ? inputEmail.value.trim() : '';

                    if (!nome || !tel || !email) {
                        alert('Por favor, preencha todos os campos.');
                        return;
                    }

                    if (modalSuccessMsg) {
                        modalSuccessMsg.innerHTML = `Obrigado, <strong>${nome}</strong>! Sua inscrição para o modelo <strong>${currentProduct.name}</strong> foi confirmada com sucesso. Enviaremos aviso prioritário no WhatsApp <em>${tel}</em> e no e-mail <em>${email}</em> assim que as reservas forem liberadas.`;
                    }

                    if (modalFormView) modalFormView.style.display = 'none';
                    if (modalSuccessView) modalSuccessView.style.display = 'block';
                });
            }
        });
    </script>

    <!-- Estilos Fielmente Alinhados à Imagem de Referência -->
    <style is:global>
        /* Fundo 100% Branco Puro e Remoção de Texturas */
        html,
        body {
            background-color: #FFFFFF !important;
        }

        .noise-layer,
        .grid-guide {
            display: none !important;
        }

        .page-white-bg {
            background-color: #FFFFFF !important;
            min-height: 100vh;
            padding-top: 5.5rem;
            padding-bottom: 5rem;
        }

        .product-page-container {
            max-width: 1240px;
            margin: 0 auto;
            padding: 1.5rem 2rem;
        }

        /* Breadcrumbs Minimalistas */
        .product-breadcrumbs {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-family: var(--font-mono, monospace);
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            color: #8C8C88;
            margin-bottom: 2.2rem;
        }

        .crumb-link {
            color: #8C8C88;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .crumb-link:hover {
            color: #1C1C1C;
        }

        .crumb-sep {
            color: #D1D1CD;
        }

        .crumb-active {
            color: #1C1C1C;
            font-weight: 700;
        }

        /* Grid Principal de 2 Colunas */
        .product-layout-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
            gap: 3.5rem;
            align-items: start;
            width: 100%;
        }

        @media (max-width: 960px) {
            .product-layout-grid {
                grid-template-columns: 1fr;
                gap: 2.5rem;
            }
        }

        /* ==============================================================
           COLUNA ESQUERDA: FOTOS E ITENS INCLUSOS
           ============================================================== */
        .product-gallery-column {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            min-width: 0;
            width: 100%;
        }

        .product-hero-frame {
            position: relative;
            background: #000000;
            border-radius: 4px;
            overflow: hidden;
            width: 100%;
        }

        .frame-badges-overlay {
            position: absolute;
            top: 1rem;
            left: 1rem;
            right: 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 2;
        }

        .badge-pill {
            font-family: var(--font-mono, monospace);
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0.3rem 0.65rem;
            border-radius: 3px;
        }

        .badge-dark {
            background: #1C1C1C;
            color: #FFFFFF;
        }

